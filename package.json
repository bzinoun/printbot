{
  "name": "printbot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot WhatsApp : un vocal → Claude conçoit un objet 3D → aperçu → confirmation → impression sur Bambu Lab",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "setup": "tsx --env-file=.env scripts/setup-instance.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "tsx scripts/smoke.ts",
    "test:coverage": "vitest run --coverage --coverage.include='src/**' --coverage.exclude='src/__tests__/**' --coverage.exclude='src/index.ts'",
    "check": "tsc --noEmit && vitest run && tsx scripts/smoke.ts",
    "snapshot": "tsx --env-file=.env scripts/snapshot.ts",
    "test:unit": "vitest run src",
    "test:integration": "vitest run test/integration"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "sharp": "^0.34.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
