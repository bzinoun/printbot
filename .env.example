# ── Serveur PrintBot ──────────────────────────────────────────
PORT=4100

# ── WhatsApp (Evolution API, même stack qu'AthenIA) ───────────
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=printbot-dev-key-change-me
EVOLUTION_INSTANCE=printbot
# URL que le conteneur Evolution appelle pour livrer les messages
WEBHOOK_PUBLIC_URL=http://host.docker.internal:4100/webhook

# Numéros autorisés à piloter l'imprimante (chiffres uniquement, indicatif inclus)
# Ex : 212612345678. Plusieurs numéros séparés par des virgules.
ALLOWED_NUMBERS=

# ── Transcription des vocaux (Groq Whisper, comme AthenIA) ────
GROQ_API_KEY=
# fr | ar | en … (vide = détection automatique)
STT_LANGUAGE=fr

# ── Réponses vocales (ElevenLabs, optionnel) ──────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
VOICE_REPLIES=true

# ── Claude Code (headless) ────────────────────────────────────
CLAUDE_BIN=claude
# Modèle optionnel (ex : opus, sonnet). Vide = défaut de Claude Code.
CLAUDE_MODEL=
# Le bot tourne sans humain devant le terminal : les outils doivent être autorisés.
# bypassPermissions = tout autorisé dans le dossier de job (numéros whitelistés uniquement).
CLAUDE_PERMISSION_MODE=bypassPermissions
# Dossier de ton plugin Bambu si non installé globalement (optionnel)
CLAUDE_PLUGIN_DIR=
# Outils d'impression du plugin, interdits pendant la conception (garde-fou).
# Ex : mcp__plugin_bambu_bambu__print_file  (séparés par des virgules)
CLAUDE_PRINT_TOOLS=
# Durée max d'un appel Claude (ms)
CLAUDE_TIMEOUT_MS=480000

# ── Rendu de l'aperçu ─────────────────────────────────────────
# Sur Mac : /Applications/OpenSCAD.app/Contents/MacOS/OpenSCAD
OPENSCAD_BIN=openscad
JOBS_DIR=./jobs
